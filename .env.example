# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real secrets.

# --- Database (used by docker-compose AND the Spring app) ---
DB_USERNAME=courtuser
# Generate: openssl rand -base64 24
DB_PASSWORD=change-me
# Optional, default points at the docker-compose container
# DB_URL=jdbc:postgresql://localhost:5436/courtbooking

# --- JWT ---
# Must be at least 32 bytes for HS256. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Optional (milliseconds). Defaults: access 15 min, refresh 7 days
# JWT_ACCESS_EXPIRATION=900000
# JWT_REFRESH_EXPIRATION=604800000

# --- First admin user, created on startup if no ADMIN exists ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
